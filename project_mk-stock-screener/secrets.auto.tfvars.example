## Copy this to secrets.auto.tfvars (gitignored via *.auto.tfvars) and fill in
## real values there. Never put secret material in app.tfvars or any tracked
## file — secrets.auto.tfvars is auto-loaded by Terraform, no -var-file needed.
##
## CI reads the same content from repo secret MK_STOCK_SCREENER_SECRETS_TFVARS.

admin_key  = "localdev"
secret_key = "replace-with-a-long-random-string"
